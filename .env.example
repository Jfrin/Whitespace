# Copy to .env (never commit it)
WHITESPACE_CONTACT=you@example.com        # goes in the User-Agent so site owners can reach you
WHITESPACE_DATA_DIR=/app/data
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Free key: https://aistudio.google.com/apikey  (extraction uses the Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=10
GEMINI_BATCH_SIZE=8
