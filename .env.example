# Copy to .env (never commit it)
WHITESPACE_CONTACT=you@example.com        # goes in the User-Agent so site owners can reach you
WHITESPACE_DATA_DIR=/app/data
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Azure Foundry resource endpoint and API key; deploy gpt-4.1-mini first.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
# This is the deployment name, which can differ from the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_RPM=1212
AZURE_OPENAI_TPM=1212000
AZURE_OPENAI_BATCH_SIZE=8
# Optional USD per million tokens; leave blank until you confirm deployment pricing.
AZURE_OPENAI_INPUT_PRICE_PER_MILLION=
AZURE_OPENAI_OUTPUT_PRICE_PER_MILLION=
